{
  "name": "wifi-worker",
  "version": "1.1.0",
  "description": "Cloudflare Worker & D1 backend for kreier/wifi telemetry",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "d1:migrate:local": "wrangler d1 migrations apply wifi-mon-db --local",
    "d1:migrate:remote": "wrangler d1 migrations apply wifi-mon-db --remote",
    "build:docs": "node ../scripts/build-docs.js",
    "build": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261113.1",
    "typescript": "^5.4.5",
    "wrangler": "^4.161.0"
  }
}
